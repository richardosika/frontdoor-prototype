# PostgreSQL connection string. Render injects this from the Blueprint database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/privatefloor?schema=public"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional. When set, every request must send HTTP Basic Auth with username privatefloor and this password.
# Leave unset to leave the site open. The Render health check and the Stripe webhook stay open either way.
# Never commit a real value. The password is not written to the log.
# SITE_GATE_PASSWORD=""

# Optional. When set to at least 12 characters, startup replaces every administrator password with this value.
# Member passwords stay on the seeded demo password. Leave unset locally to keep the seeded administrator password.
# Never commit a real value. A shorter value is ignored.
# ADMIN_PASSWORD=""

# Optional startup cleanup of rows created while testing. Exact values only.
# "dry" logs a count per table and deletes nothing. "1" deletes those rows and logs the same counts.
# Anything else, including an empty value, does nothing. Unset this after the log line appears.
# The log is counts only. Seeded members, projects, templates, legal pages, settings, and admin password hashes stay.
# The demo invite PF-7K2M-91QX stays, and its use count is set back to 0 of 40.
# CLEAN_TEST_DATA=""

# Public origin for links in email, no trailing slash.
# Placeholder only. Private Floor does not have a registered domain.
# Set APP_URL and AUTH_URL to the origin where you host this app.
APP_URL="http://localhost:3000"

# Auth.js public origin. Use the same value as APP_URL.
AUTH_URL="http://localhost:3000"

# Set true behind Render's proxy. The Blueprint sets this in production.
AUTH_TRUST_HOST="true"

# Stripe TEST MODE only. Leave all of these unset to use the built-in simulated payment.
# Never put a live secret key here. Private Floor does not store card numbers.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_GC="price_..."
# STRIPE_PRICE_BROKER="price_..."
# STRIPE_PRICE_ADVISOR="price_..."

# Mail is always stored in the Outbox. Applicants are never the SMTP recipient.
# NOTICE_TEST_RECIPIENT="rich@privatefloorclub.com"
# NOTICE_DELIVERY="outbox"
# Nodemailer URL. Leave unset to keep notices in the Outbox only.
# For Gmail, EMAIL_FROM must be that same mailbox. Do not commit a real app password.
# SMTP_URL="smtps://rich%40privatefloorclub.com:APP_PASSWORD@smtp.gmail.com:465"
# EMAIL_FROM="Private Floor Club <rich@privatefloorclub.com>"
# SHOW_TEST_CODE="1"

# Help assistant. Leave both keys unset to answer from the FAQ by keyword.
# HELP_PROVIDER="keyword"
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# HELP_MODEL=""
