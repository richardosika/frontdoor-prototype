# PostgreSQL connection string. Render injects this from the Blueprint database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frontdoor?schema=public"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin of this app, no trailing slash. On Render, set this to the service URL.
AUTH_URL="http://localhost:3000"

# Set true behind Render's proxy. The Blueprint sets this in production.
AUTH_TRUST_HOST="true"
